<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.worldview.api</string>

    <key>ProgramArguments</key>
    <array>
        <string>/PATH/TO/worldview-api/.venv/bin/python</string>
        <string>/PATH/TO/worldview-api/scripts/serve.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/PATH/TO/worldview-api</string>

    <!-- Start on load, restart on crash. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Avoid hot-loop if uvicorn fails immediately for some reason. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/PATH/TO/worldview-api/logs/api.log</string>
    <key>StandardErrorPath</key>
    <string>/PATH/TO/worldview-api/logs/api.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/opt/postgresql@17/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
