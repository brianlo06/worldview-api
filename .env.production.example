# Production env template — copy to .env.production on the deploy host.
# Never commit the populated file.

# Postgres — point at the in-compose `db` service when self-hosting on the
# droplet, or the Supabase connection string if using managed Postgres.
# Example (self-hosted, inside compose network):
#   DATABASE_URL=postgresql://worldview:CHANGEME@db:5432/worldview
# Example (Supabase pooler):
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# CORS — comma-separated, no trailing slashes. Include both apex and www
# if you serve both. Cloudflare Pages preview URLs are NOT auto-included.
CORS_ORIGINS=https://example.com,https://www.example.com

# GDELT ingestion identifier. Set to something that points back at you.
GDELT_USER_AGENT=worldview-prod/1.0 (+https://example.com)

# Anthropic summarizer. Keep disabled for a free launch; flip to true once
# you've set a billing alert.
ANTHROPIC_API_KEY=
CLAUDE_SUMMARIZER_MODEL=claude-haiku-4-5
SUMMARIZER_ENABLED=false
