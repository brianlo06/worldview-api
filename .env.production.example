# Production env template — copy to `.env` on the deploy host
# (the compose stack reads from .env, both for ${VAR} substitution and
# for the api/ingest services' env_file:). Never commit the populated file.

# ---- Required by compose.yaml interpolation ------------------------------
# Domain the API lives under (e.g. example.com). Caddy serves api.${DOMAIN}
# and obtains a Let's Encrypt cert automatically on first request.
DOMAIN=example.com

# Postgres credentials for the in-compose `db` service.
POSTGRES_PASSWORD=
POSTGRES_DB=worldview_prod

# ---- Loaded into the api + ingest containers via env_file: .env ----------
# Postgres connection. When using the in-compose db, match the values above:
#   DATABASE_URL=postgresql://worldview:${POSTGRES_PASSWORD}@db:5432/worldview_prod
# When using managed Postgres (e.g. Supabase), put the full URL here instead:
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# CORS — comma-separated, no trailing slashes. Include both apex and www
# if you serve both. Cloudflare Pages preview URLs are NOT auto-included.
CORS_ORIGINS=https://example.com,https://www.example.com

# GDELT ingestion identifier. Set to something that points back at you.
GDELT_USER_AGENT=worldview-prod/1.0 (+https://example.com)

# LLM summarizer (OpenAI-compatible; defaults to NVIDIA-hosted DeepSeek).
# Keep disabled until you've set LLM_API_KEY and verified output/cost; then
# flip SUMMARIZER_ENABLED to true.
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=deepseek-ai/deepseek-v4-pro
SUMMARIZER_ENABLED=false
