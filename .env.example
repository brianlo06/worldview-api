# Postgres connection
DATABASE_URL=postgresql://brianlo@localhost:5432/worldview_dev

# CORS origins (comma-separated, no trailing slashes)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# GDELT ingestion
GDELT_USER_AGENT=worldview-dev/0.1

# Anthropic — used by the cluster summarizer (Claude Haiku 4.5).
# Leave SUMMARIZER_ENABLED=false to skip Claude calls entirely
# (cluster titles fall back to the representative event's headline).
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_SUMMARIZER_MODEL=claude-haiku-4-5
SUMMARIZER_ENABLED=false
