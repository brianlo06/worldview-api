# Postgres image with BOTH PostGIS and pgvector.
#
# The stock postgis/postgis:17-3.5 image gives us PostGIS but doesn't ship
# pgvector — and 001_init.sql does `CREATE EXTENSION vector` on first boot,
# which would fail without the .so. Add it from the PGDG apt repo that
# the upstream postgres image already configures.

FROM postgis/postgis:17-3.5

RUN apt-get update \
 && apt-get install -y --no-install-recommends postgresql-17-pgvector \
 && rm -rf /var/lib/apt/lists/*
